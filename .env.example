# ==========================================
# WhatsApp Business API Credentials
# Get these from Meta Developer Dashboard
# ==========================================

# Your WhatsApp Business Account access token (from Meta Developers)
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# Your WhatsApp Phone Number ID (from Meta Business Manager)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Webhook verify token (create any random string, use same in Meta dashboard)
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here

# ==========================================
# AI Provider API Keys (Free Tiers)
# ==========================================

# Groq - Free tier: 20 req/min, generous daily limits
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini - Free tier: 60 req/min
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI - Only if you have credits/free tier
# Get key at: https://platform.openai.com
OPENAI_API_KEY=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

# ==========================================
# Bot Configuration
# ==========================================

# Bot name for group chat mentions (without @)
BOT_NAME=Dawinix

# Maximum conversation history to keep in memory
MAX_HISTORY_MESSAGES=20

# Enable long-term memory (SQLite database)
ENABLE_LONG_TERM_MEMORY=true

# Image generation provider: "gemini" or "none" to disable
IMAGE_GENERATION_PROVIDER=gemini

# ==========================================
# Optional: Advanced Settings
# ==========================================

# Port for local development (Railway/Docker override automatically)
PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
